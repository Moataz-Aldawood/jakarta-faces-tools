{
  "name": "jakarta-ee-tools",
  "author": "Moataz Aldawood and his friend Google Gemini ;)",
  "publisher": "moataz-aldawood",
  "displayName": "Jakarta Faces Tools",
  "description": "Advanced Jakarta Faces (JSF) tools: deep nested Java EL resolution, custom composite component intelligence, real-time diagnostics, and hover documentation. GitHub: https://github.com/Moataz-Aldawood/jakarta-faces-tools",
  "version": "2.0.2",
  "icon": "logo.png",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Moataz-Aldawood/jakarta-faces-tools"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "Jakarta EE",
    "JSF",
    "Java",
    "Java EE",
    "Coding Utilities",
    "PrimeFaces",
    "OmniFaces",
    "BootsFaces",
    "Unknown Tag Detection",
    "Unknown Attribute Detection"
  ],
  "activationEvents": [
    "onLanguage:jsf",
    "onLanguage:html",
    "onLanguage:xml"
  ],
  "contributes": {
    "configuration": {
      "title": "Jakarta Faces Tools",
      "properties": {
        "jakartaFacesTools.elHighlight.enable": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "description": "Enable highlighting for EL Expressions (#{...})."
        },
        "jakartaFacesTools.elHighlight.backgroundColor": {
          "type": "string",
          "default": "rgba(100, 150, 255, 0.15)",
          "order": 2,
          "description": "Background color for EL Expressions. Supports CSS colors (e.g. rgba, hex)."
        },
        "jakartaFacesTools.elHighlight.color": {
          "type": "string",
          "default": "",
          "order": 3,
          "description": "Text color for EL Expressions (leave empty to use theme default)."
        },
        "jakartaFacesTools.elHighlight.border": {
          "type": "string",
          "default": "1px solid rgba(100, 150, 255, 0.3)",
          "order": 4,
          "description": "Border for EL Expressions."
        },
        "jakartaFacesTools.elHighlight.borderRadius": {
          "type": "string",
          "default": "3px",
          "order": 5,
          "description": "Border radius for EL Expressions."
        },
        "jakartaFacesTools.elAutocomplete.enable": {
          "type": "boolean",
          "default": false,
          "order": 6,
          "description": "(Beta Feature) Enable intelligent auto-complete for Java Managed Beans and properties inside #{...} expressions. Disabled by default."
        },
        "jakartaFacesTools.elAutocomplete.showStatusBarButton": {
          "type": "boolean",
          "default": true,
          "order": 7,
          "description": "(Beta Feature) Show the 'Clear EL Cache' button in the VS Code Status Bar when EL Auto-Complete is enabled."
        }
      }
    },
    "commands": [
      {
        "command": "jakartaFacesTools.clearElCache",
        "title": "Clear EL Auto-Complete Cache (Beta Feature)",
        "category": "Jakarta Faces Tools"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "jakartaFacesTools.clearElCache"
        }
      ]
    }
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.1.3"
  }
}
